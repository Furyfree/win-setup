theme
{
	name="modern"
	dark=auto
	background
	{
		color=#202020
		opacity=50
		effect = 2
	}
	image.align=2
	font.size=40
	shadow
	{
		enabled = True
		size = 1 
		color = #000000
		opacity = 100
		offset = 0
	}

	item
	{
		padding
		{
			top = 2
			bottom = 2
		}
		back
		{
			select = color.accent
		}
	}
	image
	{
		enabled = False
	}
	font
	{
		name = "SF Pro Text"
		weight = 4
		italic = 0
	}
	border
	{
		enabled = True
		size = 1
		color = #D3D3D3
		opacity = 26
		radius = 20
		padding
		{
			top = 4
			bottom = 4
		}
	}
	separator
	{
		size = 1
		opacity = 17

		margin
		{
			left = 12
			right = 12
		}
	}
}